    <!--上滑解锁-->
    <Unlocker name="unlocker" bounceAcceleration="3000" bounceInitSpeed="2000">
        <StartPoint h="#screen_height" w="1080" x="0" y="0" />
        <EndPoint h="200" w="1080" x="0" y="-420">
            <Path h="#screen_height" w="1080" x="0" y="0">
                <Position x="0" y="0" />
                <Position x="0" y="-250" />
            </Path>
        </EndPoint>
    </Unlocker>

</Lockscreen>